---
import Navigation from "@/components/layout/Navigation.astro";
import Footer from "@/components/layout/Footer.astro";
import GoogleFonts from "@/components/layout/GoogleFonts.astro";
import CoreScripts from "@/components/layout/CoreScripts.astro";
import GradientBackground from "@/components/ui/GradientBackground.astro";
import SearchModal from "@/components/search/SearchModal.astro";
import Analytics from "@vercel/analytics/astro";
import "@/styles/index.css";

export type Props = {
  titleShort: string;
  titleFull?: string;
  gradientVariant?: "subtle" | "full" | "error";
};

const { titleShort, titleFull, gradientVariant = "subtle" }: Props = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/tricolor-paw.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />

    <!-- fetch Google Fonts -->
    <GoogleFonts />

    <title>{titleShort}</title>
    <Analytics />
  </head>

  <body data-pagefind-body>
    <!-- Skip link for keyboard users -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:right-3 focus:z-[9999]
        focus:bg-surface-2 focus:text-content-1 focus:font-base focus:font-medium focus:italic focus:px-4 focus:py-2
        focus-outline-rounded"
    >
      skip to main content
    </a>

    <CoreScripts />
    <GradientBackground variant={gradientVariant} />
    <Navigation />
    <main
      id="main-content"
      class="relative z-[1] flex min-h-dvh flex-col items-center pb-4"
    >
      {titleFull && <h1 class="font-header text-3xl font-semibold text-content-2 tracking-wide lowercase pt-6 pb-2">{titleFull}</h1>}
      <slot />
    </main>
    <Footer />
    <SearchModal />
  </body>
</html>
