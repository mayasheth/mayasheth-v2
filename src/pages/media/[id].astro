---
// pages/media/[id].astro
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { type HeadingHierarchy } from "@/lib/helpers/toc-helpers";
import TOCHeading from "@/components/ui/TOCHeading.astro";
import MediaInfoPage from "@/components/content/MediaInfoPage.astro";
import { createHeadingHierarchy } from "@/lib/helpers/toc-helpers";
import { renderVaultMarkdown } from "@/lib/markdown/markdown-render";

export const prerender = true;

// 1. Generate a new path for every collection entry
export async function getStaticPaths() {
  const media = await getCollection("media");

  return media.map((mediaEntry) => ({
    params: { id: mediaEntry.id },
    props: { mediaEntry },
  }));
}

// 2. Get the entry directly from the prop
type Props = {
  mediaEntry: CollectionEntry<"media">;
};
const { mediaEntry } = Astro.props;

// 2.5 Rewrite markdown links and render
const markdown = mediaEntry.body ?? "";
const { html, headings } = await renderVaultMarkdown(markdown);

// 3. Set up TOC
const toc: HeadingHierarchy[] = createHeadingHierarchy(headings ?? []);
const hasToC = headings.length > 1;
---

<BaseLayout titleShort={mediaEntry.data.title.toLowerCase()}>
  <section
    data-pagefind-title={mediaEntry.data.title}
    class={`md:grid md:grid-cols-4 ${hasToC ? "mx-auto max-w-7xl" : "max-w-5xl"}`}
  >
    {
      hasToC && (
        <div class="relative mx-auto px-4 pt-4 text-balance xl:pt-10 2xl:px-0">
          <nav aria-label="Table of contents" class="max-h-64 overflow-y-scroll md:sticky md:top-18 md:bottom-10 md:max-h-dvh">
            <ul>
              {toc.map((heading) => (
                <TOCHeading heading={heading} />
              ))}
            </ul>
          </nav>
        </div>
      )
    }

    <article
      class={`mx-auto py-2 md:py-10 items-center ${hasToC ? "md:col-span-3" : "md:col-span-4 max-w-3/4"}`}
    >
      <div class=`justify-center mb-10 flex ${hasToC ? "w-full" : ""}`>
        <MediaInfoPage mediaEntry={mediaEntry} />
      </div>

      <div class="markdown-content px-4 md:px-6" set:html={html} />
    </article>
  </section>
</BaseLayout>

<script type="module" src="/scripts/toc-highlight.js"></script>
