---
import ErrorPage from "@/components/layout/ErrorPage.astro";

const quoteLines = [
  { text: "Ever tried. Ever failed.", class: "font-serif text-sm font-light text-content-4 tracking-[0.12em] leading-relaxed" },
  { text: "No matter.", class: "font-header text-xs font-semibold tracking-[0.4em] uppercase text-content-4 mt-6 mb-6" },
  { text: "Try again.", class: "font-serif text-base font-medium text-content-3 tracking-[0.06em] leading-relaxed" },
  { text: "Fail again.", class: "font-serif text-lg font-semibold text-content-2 tracking-[0.02em] leading-relaxed mt-1" },
  { text: "Fail better.", class: "font-serif text-2xl font-bold text-content-1 tracking-[-0.01em] leading-snug mt-1" },
];
---

<ErrorPage
  code="500"
  subtitle="something went wrong"
  quoteLines={quoteLines}
  attribution="Samuel Beckett · Worstward Ho"
/>
