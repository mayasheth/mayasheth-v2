---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Tag from "@/components/ui/Tag.astro";
import PawMark from "@/components/ui/PawMark.astro";
import { ColorSwatchesGrid } from "@/components/ui/ColorSwatchGrid";

const COLOR_TOKENS = [
  { name: "surface-0", varName: "--color-surface-0" },
  { name: "surface-1", varName: "--color-surface-1" },
  { name: "surface-2", varName: "--color-surface-2" },
  { name: "surface-3", varName: "--color-surface-3" },
  { name: "surface-4", varName: "--color-surface-4" },
  { name: "content-4", varName: "--color-content-4" },
  { name: "content-3", varName: "--color-content-3" },
  { name: "content-2", varName: "--color-content-2" },
  { name: "content-1", varName: "--color-content-1" },
  { name: "content-0", varName: "--color-content-0" },
];

const ACCENT_TOKENS = [
  { name: "accent-red",     varName: "--color-accent-red" },
  { name: "accent-amber",   varName: "--color-accent-amber" },
  { name: "accent-lime",    varName: "--color-accent-lime" },
  { name: "accent-teal",    varName: "--color-accent-teal" },
  { name: "accent-purple",  varName: "--color-accent-purple" },
  { name: "accent-magenta", varName: "--color-accent-magenta" },
];

const ACCENT_COLORS = [
  "var(--color-accent-red)",
  "var(--color-accent-amber)",
  "var(--color-accent-lime)",
  "var(--color-accent-teal)",
  "var(--color-accent-purple)",
  "var(--color-accent-magenta)",
];

const ACCENT_NAMES = ["red", "amber", "lime", "teal", "purple", "magenta"];
---

<BaseLayout titleShort="design" titleFull="design system">
  <div class="mx-auto max-w-5xl space-y-4 px-4 pb-16">

    <!-- GLASS SURFACES -->
    <section class="glass bg-surface-0/55 border border-pale-grey/10 rounded-xl p-6 flex flex-col items-center">
      <p class="font-header text-xs font-semibold uppercase tracking-widest text-content-4 mb-4">glass surfaces</p>
      <div class="grid w-full grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">

        <!-- dark glass card -->
        <div class="flex flex-col gap-2">
          <div class="glass bg-surface-0/55 border border-pale-grey/10 rounded-xl p-4 h-24 flex items-center justify-center hover:bg-surface-0/40 transition-colors duration-[700ms] ease-in-out cursor-default">
            <span class="font-base text-xs text-content-3">glass card</span>
          </div>
          <p class="font-mono text-xs text-content-4">glass bg-surface-0/55</p>
          <p class="font-base text-xs text-content-4">main containers, cards</p>
        </div>

        <!-- surface-frost -->
        <div class="flex flex-col gap-2">
          <div class="surface-frost rounded-xl p-4 h-24 flex items-center justify-center">
            <span class="font-base text-xs text-content-3">surface-frost</span>
          </div>
          <p class="font-mono text-xs text-content-4">surface-frost</p>
          <p class="font-base text-xs text-content-4">inert wells, commentary</p>
        </div>

        <!-- ctrl-frost -->
        <div class="flex flex-col gap-2">
          <div class="ctrl-frost rounded-xl p-4 h-24 flex items-center justify-center cursor-pointer">
            <span class="font-base text-xs">ctrl-frost</span>
          </div>
          <p class="font-mono text-xs text-content-4">ctrl-frost</p>
          <p class="font-base text-xs text-content-4">interactive chips, CTAs</p>
        </div>

        <!-- ctrl-glass -->
        <div class="flex flex-col gap-2">
          <div class="ctrl-glass rounded-xl p-4 h-24 flex items-center justify-center cursor-pointer">
            <span class="font-base text-xs">ctrl-glass</span>
          </div>
          <p class="font-mono text-xs text-content-4">ctrl-glass</p>
          <p class="font-base text-xs text-content-4">sort/filter controls</p>
        </div>

      </div>

      <!-- active states -->
      <p class="font-header text-xs font-semibold uppercase tracking-widest text-content-4 mt-6 mb-3 self-start">active states</p>
      <div class="flex flex-wrap gap-2 self-start">
        <span class="ctrl-frost ctrl-frost-active rounded-full px-3 py-1 font-base text-sm font-light">ctrl-frost-active</span>
        <button class="ctrl-glass ctrl-glass-active rounded-full px-3 py-1 font-base text-sm font-light">ctrl-glass-active</button>
        <span class="ctrl-frost rounded-full px-3 py-1 font-base text-sm font-light cursor-pointer">ctrl-frost (hover me)</span>
        <button class="ctrl-glass rounded-full px-3 py-1 font-base text-sm font-light">ctrl-glass (hover me)</button>
      </div>
    </section>

    <!-- COLOR -->
    <section class="glass bg-surface-0/55 border border-pale-grey/10 rounded-xl p-6 flex flex-col items-center">
      <p class="font-header text-xs font-semibold uppercase tracking-widest text-content-4 mb-4">color</p>

      <p class="font-base text-xs text-content-4 mb-2 uppercase tracking-widest">surface · content</p>
      <div class="max-w-xs">
        <ColorSwatchesGrid colors={COLOR_TOKENS} client:only="react" />
      </div>

      <p class="font-base text-xs text-content-4 mt-5 mb-2 uppercase tracking-widest">accents</p>
      <div class="max-w-xs">
        <ColorSwatchesGrid colors={ACCENT_TOKENS} small={true} client:only="react" />
      </div>
      <p class="font-base text-xs text-content-4 mt-1">click to copy OKLCH · accent colors are contextual, not semantic</p>

      <p class="font-base text-xs text-content-4 mt-5 mb-2 uppercase tracking-widest">accents on ctrl-frost tags</p>
      <div class="flex flex-wrap gap-2">
        {ACCENT_NAMES.map((name, i) => (
          <Tag color={ACCENT_COLORS[i]}>{name}</Tag>
        ))}
        <Tag>default (content-3)</Tag>
      </div>
    </section>

    <!-- TYPOGRAPHY -->
    <section class="glass bg-surface-0/55 border border-pale-grey/10 rounded-xl p-6 space-y-5 flex flex-col items-center">
      <p class="font-header text-xs font-semibold uppercase tracking-widest text-content-4">typography</p>

      <!-- Font families -->
      <div class="w-full space-y-3">
        <div class="flex items-baseline gap-4">
          <span class="font-mono text-xs text-content-4 w-24 shrink-0">font-base</span>
          <span class="font-base text-xl font-light text-content-1">Montserrat — body, UI</span>
        </div>
        <div class="flex items-baseline gap-4">
          <span class="font-mono text-xs text-content-4 w-24 shrink-0">font-header</span>
          <span class="font-header text-xl font-semibold text-content-1">Schibsted Grotesk — headings, labels</span>
        </div>
        <div class="flex items-baseline gap-4">
          <span class="font-mono text-xs text-content-4 w-24 shrink-0">font-serif</span>
          <span class="font-serif text-xl font-medium text-content-1">Playfair — accent only</span>
        </div>
        <div class="flex items-baseline gap-4">
          <span class="font-mono text-xs text-content-4 w-24 shrink-0">font-mono</span>
          <span class="font-mono text-xl text-content-1">Inconsolata — dates, code</span>
        </div>
      </div>

      <!-- Weight scale -->
      <div class="w-full">
        <p class="font-base text-xs text-content-4 uppercase tracking-widest mb-2">weight scale (Montserrat)</p>
        <div class="flex flex-wrap gap-x-6 gap-y-1">
          <span class="font-base text-base font-light text-content-2">light 300</span>
          <span class="font-base text-base font-medium text-content-2">medium 375</span>
          <span class="font-base text-base font-semibold text-content-2">semibold 450</span>
          <span class="font-base text-base font-bold text-content-2">bold 600</span>
          <span class="font-base text-base font-extrabold text-content-2">extrabold 750</span>
        </div>
      </div>

      <!-- Size scale -->
      <div class="w-full">
        <p class="font-base text-xs text-content-4 uppercase tracking-widest mb-2">size scale</p>
        <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
          <span class="font-base text-xs text-content-3">xs</span>
          <span class="font-base text-sm text-content-3">sm</span>
          <span class="font-base text-base text-content-3">base</span>
          <span class="font-base text-lg text-content-3">lg</span>
          <span class="font-base text-xl text-content-2">xl</span>
          <span class="font-base text-2xl text-content-2">2xl</span>
          <span class="font-base text-3xl text-content-1">3xl</span>
        </div>
      </div>
    </section>

    <!-- COMPONENTS -->
    <section class="glass bg-surface-0/55 border border-pale-grey/10 rounded-xl p-6 space-y-6 flex flex-col items-center">
      <p class="font-header text-xs font-semibold uppercase tracking-widest text-content-4">components</p>

      <!-- PawMark variants -->
      <div class="w-full">
        <p class="font-base text-xs text-content-4 uppercase tracking-widest mb-3">pawmark variants</p>
        <div class="flex flex-wrap gap-8 items-center">
          <div class="flex flex-col items-center gap-2">
            <PawMark variant="default" size="64px" />
            <span class="font-mono text-xs text-content-4">default</span>
          </div>
          <div class="flex flex-col items-center gap-2">
            <PawMark variant="teal-blue" size="64px" />
            <span class="font-mono text-xs text-content-4">teal-blue</span>
          </div>
          <div class="flex flex-col items-center gap-2">
            <PawMark variant="magenta-teal" size="64px" />
            <span class="font-mono text-xs text-content-4">magenta-teal</span>
          </div>
        </div>
      </div>

      <!-- Tags -->
      <div class="w-full">
        <p class="font-base text-xs text-content-4 uppercase tracking-widest mb-3">tag component</p>
        <div class="flex flex-wrap gap-2">
          <Tag>default</Tag>
          <Tag color="var(--color-accent-red)">accent-red</Tag>
          <Tag color="var(--color-accent-amber)">accent-amber</Tag>
          <Tag color="var(--color-accent-lime)">accent-lime</Tag>
          <Tag color="var(--color-accent-teal)">accent-teal</Tag>
          <Tag color="var(--color-accent-purple)">accent-purple</Tag>
          <Tag color="var(--color-accent-magenta)">accent-magenta</Tag>
          <Tag as="button" class="ctrl-frost-active">active</Tag>
        </div>
      </div>

      <!-- ctrl-glass buttons -->
      <div class="w-full">
        <p class="font-base text-xs text-content-4 uppercase tracking-widest mb-3">ctrl-glass controls</p>
        <div class="flex flex-wrap gap-2">
          <button class="ctrl-glass rounded-full px-3 py-1 font-base text-sm font-light">all</button>
          <button class="ctrl-glass ctrl-glass-active rounded-full px-3 py-1 font-base text-sm font-light">books</button>
          <button class="ctrl-glass rounded-full px-3 py-1 font-base text-sm font-light">podcasts</button>
          <button class="ctrl-glass rounded-full px-3 py-1 font-base text-sm font-light">articles</button>
        </div>
      </div>

      <!-- surface-frost in context -->
      <div class="w-full">
        <p class="font-base text-xs text-content-4 uppercase tracking-widest mb-3">surface-frost in context</p>
        <div class="flex gap-4">
          <div class="surface-frost flex h-20 w-20 shrink-0 items-center justify-center rounded-lg">
            <span class="font-base text-xs text-content-4">well</span>
          </div>
          <div class="surface-frost flex-1 rounded-lg p-4">
            <p class="font-base text-sm font-light text-content-1">
              <span class="font-mono text-xs font-semibold text-content-3 pr-2">jan 2025</span>
              commentary text inside a surface-frost container.
            </p>
          </div>
        </div>
      </div>
    </section>

  </div>
</BaseLayout>
