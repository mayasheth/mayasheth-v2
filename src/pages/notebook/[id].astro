---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import NotebookInfo from "@/components/content/NotebookInfo.astro";
import {
  type HeadingHierarchy,
  createHeadingHierarchy,
} from "@/lib/helpers/toc-helpers";
import TOCHeading from "@/components/ui/TOCHeading.astro";
import { renderVaultMarkdown } from "@/lib/markdown/markdown-render";
import type { NotebookEntryProps } from "@/lib/types";

export const prerender = true;

export async function getStaticPaths() {
  const notebook = await getCollection("notebook");

  return notebook.map((notebookEntry) => ({
    params: { id: notebookEntry.id },
    props: { notebookEntry },
  }));
}

type Props = NotebookEntryProps;
const { notebookEntry } = Astro.props;

const markdown = notebookEntry.body ?? "";
const { html, headings } = await renderVaultMarkdown(markdown);

const toc: HeadingHierarchy[] = createHeadingHierarchy(headings);
const hasToC = toc.length > 1;
---

<BaseLayout titleShort={notebookEntry.data.title.toLowerCase()}>
  <section
    data-pagefind-title={notebookEntry.data.title}
    class={`md:grid md:grid-cols-4 ${hasToC ? "mx-auto max-w-7xl" : ""}`}
  >
    {
      hasToC && (
        <div class="relative mx-auto px-4 xl:pt-10 2xl:px-0">
          <nav class="md:sticky md:top-20">
            <ul>
              {toc.map((heading) => (
                <TOCHeading heading={heading} />
              ))}
            </ul>
          </nav>
        </div>
      )
    }

    <article
      class={`mx-auto py-10 items-center ${hasToC ? "md:col-span-3" : "md:col-span-4 max-w-3/4"}`}
    >
      <div class=`justify-center mb-10 flex ${hasToC ? "w-full" : ""}`>
        <NotebookInfo notebookEntry={notebookEntry} />
      </div>

      <div class="markdown-content px-4 md:px-6" set:html={html} />
    </article>
  </section>
</BaseLayout>

<script type="module" src="/scripts/toc-highlight.js"></script>

<script>
  // --- Notebook-only: resize markdown images whose alt text is a bare number ---
  window.addEventListener("DOMContentLoaded", () => {
    document.querySelectorAll(".markdown-content img[alt]").forEach((img) => {
      const alt = img.getAttribute("alt");
      if (alt && /^\d+$/.test(alt)) {
        (img as HTMLImageElement).style.maxWidth = `${alt}px`;
        (img as HTMLImageElement).style.height = "auto";
      }
    });
  });
</script>
