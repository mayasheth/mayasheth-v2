---
import ErrorPage from "@/components/layout/ErrorPage.astro";

const quoteLines = [
  { text: "we shall not cease from exploration,", class: "font-serif text-sm font-light text-content-4 tracking-[0.18em] leading-loose" },
  { text: "and the end of all our exploring", class: "font-serif text-base font-medium text-content-3 tracking-[0.08em] leading-relaxed mt-1" },
  { text: "will be to arrive where we started", class: "font-serif text-lg font-semibold text-content-2 tracking-[0.02em] leading-relaxed mt-1" },
  { text: "and know the place for the first time.", class: "font-serif text-2xl font-bold text-content-1 tracking-[-0.01em] leading-snug mt-1" },
];
---

<ErrorPage
  code="404"
  subtitle="page not found"
  quoteLines={quoteLines}
  attribution="T.S. Eliot · Little Gidding"
/>
